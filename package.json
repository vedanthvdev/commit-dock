{
  "name": "commit-dock",
  "displayName": "Commit Dock",
  "description": "IntelliJ-style commit UI: selectable changes, amend, stash, and safe force-push — in one consistent webview.",
  "version": "0.9.7",
  "publisher": "VedanthVasuDev",
  "license": "MIT",
  "icon": "media/commit-dock-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vedanthvdev/commit-dock.git"
  },
  "bugs": {
    "url": "https://github.com/vedanthvdev/commit-dock/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "scm",
    "amend",
    "stash"
  ],
  "activationEvents": [
    "onView:commitDock.commitView",
    "onCommand:commitDock.showCommitView",
    "onCommand:commitDock.selectAll",
    "onCommand:commitDock.deselectAll",
    "onCommand:commitDock.stageSelected",
    "onCommand:commitDock.unstageSelected",
    "onCommand:commitDock.discardSelected",
    "onCommand:commitDock.push",
    "onCommand:commitDock.pushForceWithLease",
    "onCommand:commitDock.checkoutLocalBranch",
    "onCommand:commitDock.createBranchFromHead",
    "onCommand:commitDock.copyHeadRevision",
    "onCommand:commitDock.openExternalMergeTool",
    "onCommand:commitDock.openFirstMergeConflictDiff",
    "onCommand:commitDock.refreshCommitView",
    "onCommand:commitDock.cherryPickCommit",
    "onCommand:commitDock.revertCommit"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commit-dock",
          "title": "Commit Dock",
          "icon": "media/commit-dock.svg"
        }
      ]
    },
    "views": {
      "commit-dock": [
        {
          "type": "webview",
          "id": "commitDock.commitView",
          "name": "Commit"
        }
      ]
    },
    "commands": [
      {
        "command": "commitDock.showCommitView",
        "title": "Focus Commit View",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.checkoutLocalBranch",
        "title": "Checkout Local Branch…",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.createBranchFromHead",
        "title": "Create Branch from HEAD…",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.copyHeadRevision",
        "title": "Copy HEAD Revision",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.openExternalMergeTool",
        "title": "Open External Merge Tool for Conflict…",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.openFirstMergeConflictDiff",
        "title": "Open First Merge Conflict (Built-in Diff)",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.refreshCommitView",
        "title": "Refresh Commit View",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.cherryPickCommit",
        "title": "Cherry-pick Commit…",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.revertCommit",
        "title": "Revert Commit…",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.selectAll",
        "title": "Select All Changes",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.deselectAll",
        "title": "Deselect All Changes",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.stageSelected",
        "title": "Stage Selected Changes",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.unstageSelected",
        "title": "Unstage Selected Changes",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.discardSelected",
        "title": "Discard Selected Changes",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.push",
        "title": "Push",
        "category": "Commit Dock"
      },
      {
        "command": "commitDock.pushForceWithLease",
        "title": "Push (Force With Lease)",
        "category": "Commit Dock"
      }
    ],
    "keybindings": [
      {
        "command": "commitDock.showCommitView",
        "key": "ctrl+shift+alt+1",
        "mac": "cmd+shift+alt+1",
        "linux": "ctrl+shift+alt+1"
      }
    ],
    "configuration": {
      "title": "Commit Dock",
      "properties": {
        "commitDock.snapshotDebounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 2000,
          "markdownDescription": "Milliseconds to wait after Git reports a change before rebuilding the change list. Lower feels snappier; higher reduces refresh churn."
        },
        "commitDock.confirmBeforeDiscard": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When enabled, **Discard** asks for confirmation before deleting untracked files or reverting working tree files."
        },
        "commitDock.showActivityBarBadge": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a numeric badge on the **Commit Dock** activity bar icon when the primary repository has pending changes (merge conflicts, staged, unstaged, or unversioned paths)."
        },
        "commitDock.showCommitAndPushButton": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show **Commit and Push** in the Commit webview. Turn off if you prefer to commit and push in two explicit steps only."
        },
        "commitDock.externalMergeToolPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional path to a **user-provided** external merge tool executable, or a macOS `.app` bundle. Used by **Open External Merge Tool for Conflict…**; the tool is started with the conflicted file path as its **sole** argument (`execFile`-style spawn, no shell)."
        },
        "commitDock.copyHeadRevisionFormat": {
          "type": "string",
          "enum": [
            "full",
            "short"
          ],
          "default": "full",
          "markdownDescription": "Controls **Copy HEAD Revision**: copy the full 40‑character SHA, or a **short** 7‑character prefix (still resolved from full `git rev-parse HEAD`)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs --production",
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "publish:marketplace": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
